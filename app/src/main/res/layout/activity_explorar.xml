<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtSaludo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hola, María"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="#252525"/>

            <EditText
                android:id="@+id/edtBuscar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:hint="Buscar médico o especialidad"
                android:padding="12dp"
                android:background="#F2F6FB"
                android:singleLine="true"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:padding="16dp"
                android:orientation="vertical"
                android:background="#0B5FA5">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tu próxima cita"
                    android:textColor="#D9E9F6"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/txtFechaCita"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sin citas próximas"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:layout_marginTop="5dp"/>

                <TextView
                    android:id="@+id/txtDetalleCita"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginTop="5dp"/>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Especialidades"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#252525"
                android:layout_marginTop="22dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEspecialidades"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Médicos disponibles"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#252525"
                android:layout_marginTop="22dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMedicos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="10dp"/>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Explorar"
            android:textColor="#0B5FA5"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Citas"
            android:textColor="#737373"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Cuenta"
            android:textColor="#737373"/>

    </LinearLayout>

</LinearLayout>
