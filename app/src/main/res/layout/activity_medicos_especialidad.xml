<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:navigationIcon="@drawable/ic_volver"
        app:navigationIconTint="#252525"
        app:title=""
        app:navigationContentDescription="Regresar"/>

    <TextView
        android:id="@+id/txtEspecialidad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginTop="8dp"
        android:text="Cardiología"
        android:textColor="#252525"
        android:textSize="26sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginTop="4dp"
        android:text="Elige un médico para ver sus horarios."
        android:textColor="#737373"
        android:textSize="14sp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMedicosEspecialidad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="18dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"/>

</LinearLayout>