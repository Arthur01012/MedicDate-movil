<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".Vista.DetalleCitaActivity">

    <ImageView
        android:id="@+id/btnVolver"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:padding="8dp"
        android:src="@drawable/ic_volver"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_chip"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:textColor="@color/azul"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnVolver"
        tools:text="Programada" />

    <TextView
        android:id="@+id/txtFecha"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:textColor="@color/texto"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtEstado"
        tools:text="Viernes 13 de noviembre" />

    <TextView
        android:id="@+id/txtHorario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="24dp"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtFecha"
        tools:text="10:30 · 30 min" />

    <TextView
        android:id="@+id/txtEtiquetaMedico"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_card"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:text="Médico"
        android:textColor="@color/texto_secundario"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@+id/txtHorario"
        app:layout_constraintStart_toStartOf="@+id/txtHorario"
        app:layout_constraintTop_toBottomOf="@+id/txtHorario" />

    <TextView
        android:id="@+id/txtMedico"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/texto"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/txtHorario"
        app:layout_constraintStart_toStartOf="@+id/txtHorario"
        app:layout_constraintTop_toBottomOf="@+id/txtEtiquetaMedico"
        tools:text="Dra. Laura Méndez" />

    <TextView
        android:id="@+id/txtEtiquetaAtencion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:text="Atención"
        android:textColor="@color/texto_secundario"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@+id/txtHorario"
        app:layout_constraintStart_toStartOf="@+id/txtHorario"
        app:layout_constraintTop_toBottomOf="@+id/txtMedico" />

    <TextView
        android:id="@+id/txtAtencion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/texto"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/txtHorario"
        app:layout_constraintStart_toStartOf="@+id/txtHorario"
        app:layout_constraintTop_toBottomOf="@+id/txtEtiquetaAtencion"
        tools:text="Cardiología · Primera consulta" />

    <TextView
        android:id="@+id/txtEtiquetaLugar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:text="Lugar"
        android:textColor="@color/texto_secundario"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@+id/txtHorario"
        app:layout_constraintStart_toStartOf="@+id/txtHorario"
        app:layout_constraintTop_toBottomOf="@+id/txtAtencion" />

    <TextView
        android:id="@+id/txtLugar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:textColor="@color/texto"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/txtHorario"
        app:layout_constraintStart_toStartOf="@+id/txtHorario"
        app:layout_constraintTop_toBottomOf="@+id/txtEtiquetaLugar"
        tools:text="Consultorio 3" />

    <Button
        android:id="@+id/btnCancelar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/rojo"
        android:text="Cancelar cita"
        app:layout_constraintBottom_toTopOf="@+id/txtAviso"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtAviso"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:textColor="@color/texto_secundario"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Disponible hasta un día antes de la cita." />

</androidx.constraintlayout.widget.ConstraintLayout>
