<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="#F2F6FB"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/txtIniciales"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="#DCEBFA"
        android:gravity="center"
        android:text="MD"
        android:textColor="#0B5FA5"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtNombreMedico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del médico"
            android:textColor="#252525"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Especialidad · Consultorio"
            android:textColor="#737373"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtProximoHorario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Próximo horario: ---"
            android:textColor="#0B5FA5"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textColor="#737373"
        android:textSize="22sp" />
</LinearLayout>