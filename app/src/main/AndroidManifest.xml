<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo_medicdate"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo_medicdate"
        android:supportsRtl="true"
        android:theme="@style/Theme.MedicDate"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".Vista.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Vista.MisCitasActivity"
            android:exported="false" />
        <activity
            android:name=".Vista.DetalleCitaActivity"
            android:exported="false" />
        <activity
            android:name=".Vista.CuentaActivity"
            android:exported="false" />
        <activity
            android:name=".Vista.DatosPersonalesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Vista.RecuperarCorreoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Vista.RecuperarContrasenaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Vista.RegistroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Vista.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Vista.CitaConfirmadaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Vista.ConfirmarCitaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Vista.RecervarCitaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Vista.ExplorarActivity"
            android:exported="false" />

        <activity
            android:name=".Vista.MedicosEspecialidadActivity"
            android:exported="false" />
    </application>

</manifest>